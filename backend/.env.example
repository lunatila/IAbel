# LLM Provider Configuration
# Escolha qual provedor usar: "ollama", "openai", "gemini"
LLM_PROVIDER=gemini

# Google Gemini API Key (recomendado)
GOOGLE_API_KEY=your_google_api_key_here
# Modelo Gemini (cada modelo tem sua própria cota diária no plano gratuito)
GEMINI_MODEL=gemini-2.5-flash
# Tokens de raciocínio interno, somados ao limite da resposta (padrão 1024).
# Com 0 o raciocínio pedido pelo prompt do RAG v3 aparece na resposta.
# GEMINI_THINKING_BUDGET=1024

# OpenAI API Key (alternativa)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4

# Anthropic API Key (alternativa)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (local - sem API key necessária)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# Database URL (if using SQLAlchemy)
DATABASE_URL=sqlite:///./data/isabel.db

# CORS origins
CORS_ORIGINS=["http://localhost:3000"]
